# Copie para .env (o `make up` faz isso sozinho). O .env NUNCA vai para o git.
# Valores abaixo são só para desenvolvimento local. Em produção, todos são obrigatórios e diferentes destes.

ENVIRONMENT=development

# Banco (docker compose). ponto_owner = dono, roda migrações. ponto_app = usado pela API.
OWNER_DB_PASSWORD=ponto_owner_dev
APP_DB_PASSWORD=ponto_app_dev
POSTGRES_PORT=5434
API_PORT=8002

# Chave que cifra o segredo do segundo fator (Fernet). Em desenvolvimento pode ficar vazia (usa uma chave de dev).
# Em produção é obrigatória. Gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Origens do front-end que podem alterar dados (proteção CSRF).
ALLOWED_ORIGINS=http://localhost:5175

# Em produção (HTTPS): true.
COOKIE_SECURE=false

TZ=America/Sao_Paulo
